# Tag: config
# Path: /Users/hodduk/Documents/git/gearlog/.env.example

# ============================================
# Supabase 설정
# ============================================
# 로컬 개발: supabase start 후 출력되는 값 사용
# 클라우드 이전: Supabase 대시보드에서 값 복사
# ============================================

# Supabase URL (로컬 기본값: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (로컬: supabase start 출력값)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Database 설정 (Prisma용)
# ============================================
# 로컬 기본값: supabase start 시 자동 생성되는 PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
